*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pythonenv*

# ============================================
# DJANGO
# ============================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/staticfiles/
/media/
*.sqlite3
*.db

# ============================================
# IDE / EDITORES
# ============================================
# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
*.un~

# ============================================
# SISTEMAS OPERATIVOS
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Mac
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
*.pid
*.pid.lock

# ============================================
# ENTORNO Y VARIABLES
# ============================================
.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# ============================================
