# ============================================
.coverage
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
*.pytest_cache

# ============================================
# DEPENDENCIAS Y PAQUETES
# ============================================
*.egg-info/
*.egg
dist/
build/
develop-eggs/
downloads/
eggs/
parts/
bin/
var/
sdist/
*.whl
*.egg-info/

# ============================================
# ARCHIVOS DE LOGS Y TEMPORALES
# ============================================
*.log
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# ============================================
# DOCUMENTACIÓN
# ============================================
/docs/_build/
/site/
/_site/

# ============================================
