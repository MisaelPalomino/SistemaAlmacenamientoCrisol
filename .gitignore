# ============================================
*.bak
*.backup
*.orig
*.rej
*.patch
.DS_Store
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# ARCHIVOS DE BASE DE DATOS (SEGURIDAD)
# ============================================
*.sql
*.dump
*.backup

